{
  "manifest_version": 3,
  "name": "Rephraser — paraphrase with the Claude API",
  "short_name": "Rephraser",
  "version": "1.0.0",
  "description": "Select text anywhere to paraphrase, fix, humanize or translate it with your own Claude API key. Copy or replace in place.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rephraser",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "contextMenus", "clipboardWrite", "activeTab"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "paraphrase-selection": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Paraphrase the selected text (or the focused field)"
    },
    "humanize-selection": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Humanize the selected text (or the focused field)"
    },
    "grammar-selection": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Fix grammar in the selected text (or the focused field)"
    }
  }
}
